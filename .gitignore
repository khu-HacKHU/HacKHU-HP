# 환경변수 — 시크릿은 GitHub Secrets에만 둔다 (docs/security/secure-coding.md)
.env
.env.*
!.env.example

# Terraform — tfstate에는 DB 비밀번호 같은 값이 평문으로 들어간다
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
terraform.tfvars
*.auto.tfvars
!*.tfvars.example

# 자격 증명 파일 — 저장소 안에 두면 그대로 커밋되므로 파일명 자체를 막는다
client_secret*.json
*credentials*.json
*.pem
*.key
*.p12
application-secret*.yml
application-secret*.properties

# 보안 도구 로컬 출력물
*.sarif
gitleaks-report.*
semgrep-report.*
checkov-report.*

# AI 도구 스킬 — 각자 설치해서 쓴다. 서드파티 코드를 레포에 벤더링하지 않는다.
# 라이선스 표기가 없고, 자동 실행 훅이 딸려 있고, 보안 스캔 결과가 우리 코드가 아닌 것으로 덮인다
.agents/
skills-lock.json
# 스킬이 만드는 빌드 산출물
.taste-skill/

# Node
node_modules/
dist/
.next/
coverage/

# Java / Gradle
build/
.gradle/
out/

